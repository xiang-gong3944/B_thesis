\usepackage{tcolorbox}
\tcbuselibrary{breakable, skins, theorems}

\newtcbtheorem[number within = chapter]{defbox}{定義}{enhanced,
    attach boxed title to top left={xshift=5mm,yshift=-3mm},
    boxed title style={colframe = green!35!black, colback = white},
    coltitle = black,
    colback = white,
    colframe = green!35!black,
    fonttitle = \bfseries,
    breakable = true,
    top = 4mm
}{defbox}

\newtcbtheorem[number within = chapter]{theorembox}{定理}{enhanced,
    attach boxed title to top left={xshift=5mm,yshift=-3mm},
    boxed title style={colframe = blue!35!black, colback = white},
    coltitle = black,
    colback = white,
    colframe = blue!35!black,
    fonttitle = \bfseries,
    breakable = true,
    top = 4mm
}{theorembox}

\newtcbtheorem[number within = chapter]{examplebox}{例}{enhanced,
    attach boxed title to top left={xshift=5mm,yshift=-3mm},
    boxed title style={colframe = red!75!black, colback = white},
    coltitle = black,
    colback = white,
    colframe = red!75!black,
    fonttitle = \bfseries,
    breakable = true,
    top = 4mm
}{examplebox}

\tcbset{
  proofstyle/.style={
    enhanced,
    colback=white,
    colframe=white,
    borderline west={1pt}{0pt}{black!50!white}, % 左側に黒い縦線
    boxrule=0pt,
    sharp corners,
    before skip=10pt,
    after skip=10pt,
    breakable,
    coltitle=black,
    fonttitle=\bfseries,attach boxed title to top left={xshift=0.5mm,yshift=-1mm}, % タイトルの位置調整
    boxed title style={
      colback=gray!35!white,      % タイトル背景
      frame hidden,       % タイトル枠線
      boxrule=0.5pt,
      rounded corners
    },
    after upper={\hfill$\square$}
  }
}
\newtcolorbox{proofbox}[1][]{proofstyle,title=証明,#1}
